{
  "name": "pocket",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "npm run prepare && NODE_ENV=production node toolchain build",
    "deno": "npm run build && deno run -A deploy/index.js",
    "gzip": "gzip --best --keep --no-name deploy/dist/index.html",
    "lib": "node toolchain lib",
    "prepare": "rm -rf deploy/dist && mkdir deploy/dist",
    "start": "npm run prepare && NODE_ENV=development node toolchain start"
  },
  "dependencies": {
    "classcat": "5.0.5",
    "superfine": "8.2.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/plugin-syntax-jsx": "7.28.6",
    "@mapbox/rehype-prism": "0.9.0",
    "@mdx-js/esbuild": "2.3.0",
    "@tabler/icons": "1.119.0",
    "babel-plugin-preval": "5.1.0",
    "clean-css": "5.3.3",
    "culori": "2.1.1",
    "esbuild": "0.14.54",
    "escape-html": "1.0.3",
    "fast-glob": "3.3.3",
    "mini-svg-data-uri": "1.4.4",
    "sass": "1.78.0",
    "svgo": "2.8.0",
    "typescript": "5.9.3",
    "uglify-js": "3.19.3"
  },
  "optionalDependencies": {
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "16.6.2",
    "eslint-plugin-promise": "6.6.0",
    "eslint-plugin-react": "7.37.5",
    "stylelint": "14.16.1",
    "stylelint-config-clean-order": "6.1.0",
    "stylelint-config-standard-scss": "6.1.0"
  }
}
